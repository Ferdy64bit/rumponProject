<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="@dimen/forecast_card_width"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/spacing_10"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="@dimen/radius_16"
    app:cardElevation="0dp"
    app:strokeColor="@color/divider"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/forecast_card_min_height"
        android:orientation="vertical"
        android:padding="@dimen/spacing_12">

        <TextView
            android:id="@+id/tvForecastDate"
            style="@style/TextAppearance.App.LabelSmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            tools:text="HARI INI" />

        <TextView
            android:id="@+id/tvForecastWeather"
            style="@style/TextAppearance.App.TitleSmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_6"
            android:fontFamily="sans-serif-medium"
            android:maxLines="3"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            tools:text="Waspada untuk perairan sekitar" />

        <TextView
            android:id="@+id/tvForecastWave"
            style="@style/TextAppearance.App.BodySmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_6"
            android:maxLines="3"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            tools:text="Gelombang rendah sampai sedang" />

        <TextView
            android:id="@+id/tvForecastWind"
            style="@style/TextAppearance.App.BodySmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_4"
            android:maxLines="3"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            tools:text="Angin Selatan ke Barat Daya 16-40" />

        <TextView
            android:id="@+id/tvForecastWarning"
            style="@style/TextAppearance.App.BodySmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_4"
            android:maxLines="3"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            tools:text="Waspada angin kencang" />

        <TextView
            android:id="@+id/tvForecastBadge"
            style="@style/TextAppearance.App.LabelSmall"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginTop="@dimen/spacing_8"
            android:background="@drawable/bg_chip_primary"
            android:gravity="center"
            android:minWidth="92dp"
            android:paddingStart="@dimen/spacing_10"
            android:paddingEnd="@dimen/spacing_10"
            android:textColor="@color/white"
            tools:text="WASPADA" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
