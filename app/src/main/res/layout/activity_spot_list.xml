<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="@string/back"
            android:padding="11dp"
            android:src="@drawable/ic_back_rounded"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/text_primary" />

        <TextView
            android:id="@+id/tvToolbarTitle"
            style="@style/TextAppearance.App.TitleMedium"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/fishing_spots"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnToolbarSearch"
            app:layout_constraintStart_toEndOf="@id/btnBack"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/btnToolbarSearch"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="@string/search"
            android:padding="11dp"
            android:src="@drawable/ic_search_rounded"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/text_primary" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/searchBar"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginTop="@dimen/spacing_8"
        android:layout_marginEnd="@dimen/screen_margin"
        android:background="@drawable/bg_search_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_16"
        android:paddingEnd="@dimen/spacing_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@string/search"
            android:src="@drawable/ic_search_rounded"
            app:tint="@color/text_secondary" />

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/spacing_10"
            android:background="@color/transparent"
            android:hint="@string/search_spot_hint"
            android:inputType="text"
            android:padding="0dp"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="14sp" />
    </LinearLayout>

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupFilter"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginTop="@dimen/spacing_14"
        android:layout_marginEnd="@dimen/screen_margin"
        app:singleLine="true"
        app:singleSelection="true"
        app:selectionRequired="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/searchBar">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipBest"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:checkable="true"
            android:checked="true"
            android:gravity="center"
            android:text="@string/filter_best"
            android:textColor="@color/chip_filter_text"
            app:checkedIconVisible="false"
            app:chipBackgroundColor="@color/chip_filter_background"
            app:chipStrokeWidth="0dp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipNearest"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:checkable="true"
            android:gravity="center"
            android:text="@string/filter_nearest"
            android:textColor="@color/chip_filter_text"
            app:checkedIconVisible="false"
            app:chipBackgroundColor="@color/chip_filter_background"
            app:chipStrokeWidth="0dp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipFavorite"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:checkable="true"
            android:gravity="center"
            android:text="@string/filter_favorite"
            android:textColor="@color/chip_filter_text"
            app:checkedIconVisible="false"
            app:chipBackgroundColor="@color/chip_filter_background"
            app:chipStrokeWidth="0dp" />
    </com.google.android.material.chip.ChipGroup>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSpotList"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginTop="@dimen/spacing_10"
        android:layout_marginEnd="@dimen/screen_margin"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingBottom="@dimen/spacing_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/chipGroupFilter"
        tools:itemCount="5"
        tools:listitem="@layout/item_spot_list" />
</androidx.constraintlayout.widget.ConstraintLayout>
