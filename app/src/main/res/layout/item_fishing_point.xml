<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="@dimen/spot_card_width"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/nearby_spot_list_height"
    android:layout_marginEnd="@dimen/spacing_12"
    app:cardBackgroundColor="@color/transparent"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivSpotImage"
        android:layout_width="match_parent"
        android:layout_height="@dimen/spot_card_image_height"
            android:contentDescription="@string/spot_image"
            android:scaleType="centerCrop"
            android:src="@drawable/img_spot_dermaga"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlayAppCornerMedium" />

        <TextView
            android:id="@+id/tvSpotName"
            style="@style/TextAppearance.App.LabelLarge"
            android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_8"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:includeFontPadding="true"
        android:maxLines="2"
        android:minLines="1"
        android:textColor="@color/text_primary"
        android:textSize="12sp"
            tools:text="Pantai Tanjung Karang" />

        <TextView
            android:id="@+id/tvDistance"
            style="@style/TextAppearance.App.BodySmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_2"
        android:ellipsize="end"
        android:includeFontPadding="true"
        android:maxLines="1"
        android:minLines="1"
        android:textColor="@color/text_secondary"
            android:textSize="11sp"
            tools:text="3,0 km" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
