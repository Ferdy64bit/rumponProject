<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/homeScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="@dimen/bottom_nav_safe_padding">

        <LinearLayout
            android:id="@+id/homeContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="@dimen/top_safe_spacing"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="@dimen/spacing_24">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/homeHeader"
                android:layout_width="match_parent"
                android:layout_height="56dp">

                <ImageButton
                    android:id="@+id/btnMenu"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_icon_button"
                    android:contentDescription="@string/menu"
                    android:padding="12dp"
                    android:src="@drawable/ic_menu_rounded"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/text_primary" />

                <LinearLayout
                    android:id="@+id/headerCopy"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_12"
                    android:layout_marginEnd="@dimen/spacing_12"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/btnNotification"
                    app:layout_constraintStart_toEndOf="@id/btnMenu"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:id="@+id/tvHallo"
                        style="@style/TextAppearance.App.TitleMedium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:text="Halo, Pemancing"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/tvWelcomeBack"
                        style="@style/TextAppearance.App.BodySmall"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Selamat datang kembali"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnNotification"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_icon_button"
                    android:contentDescription="@string/notifications"
                    android:padding="12dp"
                    android:src="@drawable/ic_notification_rounded"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/text_primary" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/weatherCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_20"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="4dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_weather_gradient"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_20">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:id="@+id/weatherCopy"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            app:layout_constraintEnd_toStartOf="@id/ivWeatherMain"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <TextView
                                android:id="@+id/tvTemperatureLarge"
                                style="@style/TextAppearance.App.HeadlineLarge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="28&#176;C"
                                android:textColor="@color/white"
                                android:textSize="36sp" />

                            <TextView
                                android:id="@+id/tvCondition"
                                style="@style/TextAppearance.App.LabelLarge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Berawan"
                                android:textColor="@color/white"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tvLocationName"
                                style="@style/TextAppearance.App.BodySmall"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:alpha="0.86"
                                android:text="Tanjung Anom, Tangerang"
                                android:textColor="@color/white"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/ivWeatherMain"
                            android:layout_width="82dp"
                            android:layout_height="82dp"
                            android:contentDescription="@string/weather_icon"
                            android:src="@drawable/ic_weather_cloud"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <LinearLayout
                        android:id="@+id/weatherMetrics"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_20"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.95"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvHumidityVal"
                                style="@style/TextAppearance.App.LabelLarge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="72%"
                                android:textColor="@color/white"
                                android:textSize="14sp" />

                            <TextView
                                style="@style/TextAppearance.App.BodySmall"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:alpha="0.76"
                                android:text="Kelembapan"
                                android:textColor="@color/white"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="34dp"
                            android:layout_marginHorizontal="@dimen/spacing_8"
                            android:background="#33FFFFFF" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.85"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvWindVal"
                                style="@style/TextAppearance.App.LabelLarge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="12 km/h"
                                android:textColor="@color/white"
                                android:textSize="14sp" />

                            <TextView
                                style="@style/TextAppearance.App.BodySmall"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:alpha="0.76"
                                android:text="Angin"
                                android:textColor="@color/white"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="34dp"
                            android:layout_marginHorizontal="@dimen/spacing_8"
                            android:background="#33FFFFFF" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.2"
                            android:gravity="end"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvPressureVal"
                                style="@style/TextAppearance.App.LabelLarge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="1009 hPa"
                                android:textColor="@color/white"
                                android:textSize="14sp" />

                            <TextView
                                style="@style/TextAppearance.App.BodySmall"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:alpha="0.76"
                                android:text="Tekanan"
                                android:textColor="@color/white"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/recommendationCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="4dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_12">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/spacing_4"
                        android:paddingEnd="@dimen/spacing_4">

                        <TextView
                            style="@style/TextAppearance.App.LabelSmall"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="REKOMENDASI HARI INI"
                            android:textColor="@color/text_secondary" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@string/view_detail"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/text_secondary" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/recommendationStatusPanel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_recommend_card"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/spacing_16">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvRecommendationStars"
                                style="@style/TextAppearance.App.TitleSmall"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="&#9733;&#9733;&#9733;&#9733;&#9733;"
                                android:textColor="@color/white"
                                android:textSize="18sp" />

                            <TextView
                                android:id="@+id/tvRecommendationTitle"
                                style="@style/TextAppearance.App.TitleMedium"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_4"
                                android:fontFamily="sans-serif-medium"
                                android:maxLines="2"
                                android:text="Sangat Direkomendasikan"
                                android:textColor="@color/white"
                                android:textSize="16sp" />

                            <TextView
                                android:id="@+id/tvRecommendationSubtitle"
                                style="@style/TextAppearance.App.BodySmall"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_4"
                                android:alpha="0.88"
                                android:maxLines="2"
                                android:text="Kondisi ideal untuk memancing hari ini."
                                android:textColor="@color/white"
                                android:textSize="12sp" />

                            <LinearLayout
                                android:id="@+id/recommendationInsightRow"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_14"
                                android:orientation="vertical">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:minHeight="@dimen/touch_target"
                                    android:orientation="horizontal">

                                    <ImageView
                                        android:layout_width="@dimen/spacing_24"
                                        android:layout_height="@dimen/spacing_24"
                                        android:contentDescription="@string/info_weather"
                                        android:src="@drawable/ic_tide_wave"
                                        app:tint="@color/white" />

                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="@dimen/spacing_4"
                                        android:layout_weight="1"
                                        android:orientation="vertical">

                                        <TextView
                                            android:id="@+id/tvSafetyScore"
                                            style="@style/TextAppearance.App.LabelSmall"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:maxLines="1"
                                            android:text="Safe 78%"
                                            android:textColor="@color/white" />

                                        <TextView
                                            android:id="@+id/tvSafetyLabel"
                                            style="@style/TextAppearance.App.BodySmall"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:alpha="0.84"
                                            android:maxLines="2"
                                            android:text="Aman"
                                            android:textColor="@color/white"
                                            android:textSize="11sp" />
                                    </LinearLayout>
                                </LinearLayout>

                                <View
                                    android:layout_width="match_parent"
                                    android:layout_height="1dp"
                                    android:layout_marginVertical="@dimen/spacing_6"
                                    android:background="#40FFFFFF" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:minHeight="@dimen/touch_target"
                                    android:orientation="horizontal">

                                    <ImageView
                                        android:layout_width="@dimen/spacing_24"
                                        android:layout_height="@dimen/spacing_24"
                                        android:contentDescription="@string/info_fish_activity"
                                        android:src="@drawable/ic_fish_small"
                                        app:tint="@color/white" />

                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="@dimen/spacing_4"
                                        android:layout_weight="1"
                                        android:orientation="vertical">

                                        <TextView
                                            android:id="@+id/tvActivityScore"
                                            style="@style/TextAppearance.App.LabelSmall"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:maxLines="1"
                                            android:text="Ikan 75%"
                                            android:textColor="@color/white" />

                                        <TextView
                                            android:id="@+id/tvActivityLabel"
                                            style="@style/TextAppearance.App.BodySmall"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:alpha="0.84"
                                            android:maxLines="2"
                                            android:text="Baik"
                                            android:textColor="@color/white"
                                            android:textSize="11sp" />
                                    </LinearLayout>
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>

                        <FrameLayout
                            android:layout_width="68dp"
                            android:layout_height="68dp"
                            android:layout_marginStart="@dimen/spacing_16">

                            <com.google.android.material.progressindicator.CircularProgressIndicator
                                android:id="@+id/progressRecommendation"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:max="100"
                                android:progress="94"
                                app:indicatorColor="@color/white"
                                app:indicatorSize="58dp"
                                app:trackColor="#4DFFFFFF"
                                app:trackThickness="5dp" />

                            <TextView
                                android:id="@+id/tvRecommendationPercent"
                                style="@style/TextAppearance.App.LabelLarge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="94%"
                                android:textColor="@color/white"
                                android:textSize="14sp" />
                        </FrameLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tideCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="4dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_16">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/TextAppearance.App.LabelSmall"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="KONDISI PERAIRAN LIVE"
                            android:textColor="@color/text_secondary" />

                        <TextView
                            android:id="@+id/tvTideDetailLink"
                            style="@style/TextAppearance.App.LabelSmall"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:gravity="center"
                            android:text="Lihat Detail"
                            android:textColor="@color/primary" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_8"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/TextAppearance.App.BodySmall"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Gelombang/jam"
                                android:textColor="@color/text_secondary" />

                            <TextView
                                android:id="@+id/tvHighTideTime"
                                style="@style/TextAppearance.App.TitleSmall"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="07:23"
                                android:textColor="@color/text_primary" />

                            <TextView
                                android:id="@+id/tvHighTideHeight"
                                style="@style/TextAppearance.App.BodySmall"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="1.8 m"
                                android:textColor="@color/text_secondary" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                style="@style/TextAppearance.App.BodySmall"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Status BMKG"
                                android:textColor="@color/text_secondary" />

                            <TextView
                                android:id="@+id/tvCurrentTideStatus"
                                style="@style/TextAppearance.App.TitleSmall"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Naik"
                                android:textColor="@color/success" />

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:contentDescription="@string/tide_up"
                                android:src="@drawable/ic_arrow_up_rounded"
                                app:tint="@color/success" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:orientation="vertical">

                            <TextView
                                style="@style/TextAppearance.App.BodySmall"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Angin BMKG"
                                android:textColor="@color/text_secondary" />

                            <TextView
                                android:id="@+id/tvLowTideTime"
                                style="@style/TextAppearance.App.TitleSmall"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="end"
                                android:maxLines="3"
                                android:text="13:45"
                                android:textColor="@color/text_primary"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tvLowTideHeight"
                                style="@style/TextAppearance.App.BodySmall"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                android:text="0.6 m"
                                android:textColor="@color/text_secondary" />
                        </LinearLayout>
                    </LinearLayout>

                    <com.example.java3.presentation.views.WaveHourlyChartView
                        android:id="@+id/waveHourlyChart"
                        android:layout_width="match_parent"
                        android:layout_height="148dp"
                        android:layout_marginTop="@dimen/spacing_12"
                        android:contentDescription="@string/tide_chart" />

                    <TextView
                        android:id="@+id/tvWaveSource"
                        style="@style/TextAppearance.App.BodySmall"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_6"
                        android:text="Grafik gelombang per jam: Open-Meteo Marine"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        style="@style/TextAppearance.App.LabelSmall"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_12"
                        android:text="PREDIKSI KONDISI MEMANCING"
                        android:textColor="@color/text_secondary" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvBmkgForecast"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_8"
                        android:clipToPadding="false"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never"
                        tools:itemCount="3"
                        tools:listitem="@layout/item_bmkg_forecast" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/nearbyHeader"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="@dimen/spacing_12"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/TextAppearance.App.LabelSmall"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="SPOT TERDEKAT"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:id="@+id/tvSeeAllSpots"
                    style="@style/TextAppearance.App.LabelSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:text="Lihat Semua"
                    android:textColor="@color/primary" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvRecommendedSpots"
                android:layout_width="match_parent"
                android:layout_height="@dimen/nearby_spot_list_height"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                tools:itemCount="2"
                tools:listitem="@layout/item_fishing_point" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
