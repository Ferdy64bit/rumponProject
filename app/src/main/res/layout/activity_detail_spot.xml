<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/detailScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="@dimen/bottom_nav_height"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="272dp">

                <ImageView
                    android:id="@+id/ivHeroImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/spot_image"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_spot_dermaga" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_detail_hero_scrim" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:layout_gravity="top"
                    android:paddingStart="@dimen/screen_margin"
                    android:paddingTop="@dimen/spacing_20"
                    android:paddingEnd="@dimen/screen_margin">

                    <ImageButton
                        android:id="@+id/btnBack"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_detail_icon_button"
                        android:contentDescription="@string/back"
                        android:padding="11dp"
                        android:src="@drawable/ic_back_rounded"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="@color/white" />

                    <ImageButton
                        android:id="@+id/btnShare"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginEnd="@dimen/spacing_10"
                        android:background="@drawable/bg_detail_icon_button"
                        android:contentDescription="@string/share"
                        android:padding="11dp"
                        android:src="@drawable/ic_share_rounded"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/btnFavorite"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="@color/white" />

                    <ImageButton
                        android:id="@+id/btnFavorite"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_detail_icon_button"
                        android:contentDescription="@string/favorite"
                        android:padding="11dp"
                        android:src="@drawable/ic_heart_rounded"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="@color/white" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="@dimen/screen_margin"
                    android:layout_marginBottom="@dimen/spacing_16"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/btnChangeSpotPhoto"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_detail_icon_button"
                        android:contentDescription="Ganti foto spot"
                        android:padding="11dp"
                        android:src="@android:drawable/ic_menu_camera"
                        app:tint="@color/white" />

                    <ImageButton
                        android:id="@+id/btnDeleteSpotPhoto"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="@dimen/spacing_8"
                        android:background="@drawable/bg_detail_icon_button"
                        android:contentDescription="Hapus foto spot"
                        android:padding="11dp"
                        android:src="@android:drawable/ic_menu_delete"
                        app:tint="@color/white" />
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:id="@+id/detailContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_detail_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_margin"
                android:paddingTop="@dimen/spacing_24"
                android:paddingEnd="@dimen/screen_margin"
                android:paddingBottom="@dimen/spacing_24">

                <TextView
                    android:id="@+id/tvSpotName"
                    style="@style/TextAppearance.App.HeadlineMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Dermaga Tanjung Anom"
                    android:textColor="@color/text_primary"
                    android:textSize="24sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_8"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="&#9733;"
                        android:textColor="@color/tertiary"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/tvRating"
                        style="@style/TextAppearance.App.BodyMedium"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_4"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="4.8 (120 ulasan)"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <TextView
                        style="@style/TextAppearance.App.BodyMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/spacing_8"
                        android:text="di sekitar Anda"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:contentDescription="@string/location"
                        android:src="@drawable/ic_location_pin"
                        app:tint="@color/text_secondary" />

                    <TextView
                        android:id="@+id/tvDistance"
                        style="@style/TextAppearance.App.BodySmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_4"
                        android:text="1.2 km"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>


                <TextView
                    android:id="@+id/tvSpotOwner"
                    style="@style/TextAppearance.App.BodySmall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_6"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Dibuat oleh Fishing Point Member"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:id="@+id/tvSpotVisibility"
                    style="@style/TextAppearance.App.LabelSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_6"
                    android:text="PUBLIC"
                    android:textColor="@color/primary" />                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/tabLayout"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="@dimen/spacing_18"
                    android:background="@color/transparent"
                    app:tabIndicatorColor="@color/primary"
                    app:tabIndicatorFullWidth="false"
                    app:tabMode="fixed"
                    app:tabRippleColor="@color/primary_light"
                    app:tabSelectedTextColor="@color/primary"
                    app:tabTextAppearance="@style/TextAppearance.App.LabelSmall"
                    app:tabTextColor="@color/text_secondary">

                    <com.google.android.material.tabs.TabItem
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tab_summary" />

                    <com.google.android.material.tabs.TabItem
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tab_weather" />

                    <com.google.android.material.tabs.TabItem
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tab_tide" />

                    <com.google.android.material.tabs.TabItem
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tab_reviews" />
                </com.google.android.material.tabs.TabLayout>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/recommendationCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_16"
                    app:cardBackgroundColor="#ECFDF3"
                    app:cardCornerRadius="@dimen/card_corner_radius"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/spacing_16">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvDetailRecommendationStars"
                                style="@style/TextAppearance.App.LabelLarge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="&#9733;&#9733;&#9733;&#9733;&#9733;"
                                android:textColor="@color/success"
                                android:textSize="18sp" />

                            <TextView
                                android:id="@+id/tvDetailRecommendationTitle"
                                style="@style/TextAppearance.App.TitleSmall"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_4"
                                android:fontFamily="sans-serif-medium"
                                android:text="@string/highly_recommended_id"
                                android:textColor="@color/success"
                                android:textSize="15sp" />
                        </LinearLayout>

                        <FrameLayout
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:layout_marginStart="@dimen/spacing_12">

                            <com.google.android.material.progressindicator.CircularProgressIndicator
                                android:id="@+id/progressDetailRecommendation"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:max="100"
                                android:progress="94"
                                app:indicatorColor="@color/success"
                                app:indicatorSize="62dp"
                                app:trackColor="#CFF7DD"
                                app:trackThickness="5dp" />

                            <TextView
                                android:id="@+id/tvDetailRecommendationPercent"
                                style="@style/TextAppearance.App.LabelLarge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="94%"
                                android:textColor="@color/success"
                                android:textSize="14sp" />
                        </FrameLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <GridLayout
                    android:id="@+id/infoGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_16"
                    android:alignmentMode="alignMargins"
                    android:columnCount="2"
                    android:rowCount="3"
                    android:useDefaultMargins="true">

                    <LinearLayout
                        style="@style/DetailInfoTile"
                        android:layout_columnWeight="1"
                        android:layout_rowWeight="1">

                        <ImageView
                            style="@style/DetailInfoIcon"
                            android:contentDescription="@string/weather_icon"
                            android:src="@drawable/ic_cloud_small"
                            app:tint="@color/primary" />

                        <TextView
                            style="@style/DetailInfoLabel"
                            android:text="@string/info_weather" />

                        <TextView
                            android:id="@+id/tvWeatherValue"
                            style="@style/DetailInfoValue"
                            android:text="@string/weather_cloudy_id" />
                    </LinearLayout>

                    <LinearLayout
                        style="@style/DetailInfoTile"
                        android:layout_columnWeight="1"
                        android:layout_rowWeight="1">

                        <ImageView
                            style="@style/DetailInfoIcon"
                            android:contentDescription="@string/info_wind"
                            android:src="@drawable/ic_wind_rounded"
                            app:tint="@color/primary" />

                        <TextView
                            style="@style/DetailInfoLabel"
                            android:text="@string/info_wind" />

                        <TextView
                            android:id="@+id/tvWindValue"
                            style="@style/DetailInfoValue"
                            android:text="12 km/h" />
                    </LinearLayout>

                    <LinearLayout
                        style="@style/DetailInfoTile"
                        android:layout_columnWeight="1"
                        android:layout_rowWeight="1">

                        <ImageView
                            style="@style/DetailInfoIcon"
                            android:contentDescription="@string/info_humidity"
                            android:src="@drawable/ic_water_drop"
                            app:tint="@color/primary" />

                        <TextView
                            style="@style/DetailInfoLabel"
                            android:text="@string/info_humidity" />

                        <TextView
                            android:id="@+id/tvHumidityValue"
                            style="@style/DetailInfoValue"
                            android:text="72%" />
                    </LinearLayout>

                    <LinearLayout
                        style="@style/DetailInfoTile"
                        android:layout_columnWeight="1"
                        android:layout_rowWeight="1">

                        <ImageView
                            style="@style/DetailInfoIcon"
                            android:contentDescription="@string/info_fish_activity"
                            android:src="@drawable/ic_fish_small"
                            app:tint="@color/primary" />

                        <TextView
                            style="@style/DetailInfoLabel"
                            android:text="@string/info_fish_activity" />

                        <TextView
                            android:id="@+id/tvFishActivityValue"
                            style="@style/DetailInfoValue"
                            android:text="@string/fish_activity_high" />
                    </LinearLayout>

                    <LinearLayout
                        style="@style/DetailInfoTile"
                        android:layout_columnWeight="1"
                        android:layout_rowWeight="1">

                        <ImageView
                            style="@style/DetailInfoIcon"
                            android:contentDescription="@string/info_tide"
                            android:src="@drawable/ic_tide_wave"
                            app:tint="@color/primary" />

                        <TextView
                            style="@style/DetailInfoLabel"
                            android:text="@string/info_tide" />

                        <TextView
                            android:id="@+id/tvTideValue"
                            style="@style/DetailInfoValue"
                            android:text="Naik (1.2 m)" />
                    </LinearLayout>

                    <LinearLayout
                        style="@style/DetailInfoTile"
                        android:layout_columnWeight="1"
                        android:layout_rowWeight="1">

                        <ImageView
                            style="@style/DetailInfoIcon"
                            android:contentDescription="@string/location"
                            android:src="@drawable/ic_location_pin"
                            app:tint="@color/primary" />

                        <TextView
                            style="@style/DetailInfoLabel"
                            android:text="@string/info_distance" />

                        <TextView
                            android:id="@+id/tvInfoDistance"
                            style="@style/DetailInfoValue"
                            android:text="1.2 km" />
                    </LinearLayout>
                </GridLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/bottomActions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_action"
        android:gravity="center_vertical"
        android:minHeight="88dp"
        android:orientation="horizontal"
        android:paddingTop="@dimen/spacing_12"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="@dimen/spacing_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNavigate"
            style="@style/WidgetAppButtonSecondary"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="@dimen/spacing_10"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/navigation"
            android:textColor="@color/primary"
            app:icon="@drawable/ic_navigation_rounded"
            app:iconTint="@color/primary"
            app:strokeColor="@color/primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveFavorite"
            style="@style/WidgetAppButtonPrimary"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="@dimen/spacing_10"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/save_favorite"
            app:icon="@drawable/ic_bookmark_rounded"
            app:iconTint="@color/white" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>


