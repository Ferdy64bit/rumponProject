<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_10"
    android:foreground="?attr/selectableItemBackground"
    android:minHeight="92dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="@dimen/radius_16"
    app:cardElevation="2dp"
    app:strokeColor="@color/divider"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="92dp"
        android:padding="@dimen/spacing_10">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivSpotImage"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:contentDescription="@string/spot_image"
            android:scaleType="centerCrop"
            android:src="@drawable/img_spot_dermaga"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlayAppCornerMedium" />

        <TextView
            android:id="@+id/tvSpotName"
            style="@style/TextAppearance.App.TitleSmall"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_12"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="2"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/ivSpotImage"
            app:layout_constraintTop_toTopOf="@id/ivSpotImage"
            tools:text="Pantai Tanjung Kait" />

        <LinearLayout
            android:id="@+id/distanceRow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_12"
            android:layout_marginTop="@dimen/spacing_6"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/ivSpotImage"
            app:layout_constraintTop_toBottomOf="@id/tvSpotName">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="@string/location"
                android:src="@drawable/ic_location_pin"
                app:tint="@color/text_secondary" />

            <TextView
                android:id="@+id/tvDistance"
                style="@style/TextAppearance.App.BodySmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_4"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                tools:text="7,6 km dari lokasi Anda" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSpotMeta"
            style="@style/TextAppearance.App.BodySmall"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_12"
            android:layout_marginTop="@dimen/spacing_6"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/ivSpotImage"
            app:layout_constraintTop_toBottomOf="@id/distanceRow"
            tools:text="Spot memancing" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>