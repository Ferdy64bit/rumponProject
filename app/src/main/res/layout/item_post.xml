<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_16"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="@dimen/card_corner_radius"
    app:cardElevation="2dp"
    app:strokeColor="#EEF2F7"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            android:paddingStart="@dimen/spacing_12"
            android:paddingEnd="@dimen/spacing_8">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivUserProfile"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:contentDescription="@string/user_name"
                android:scaleType="centerCrop"
                android:src="@drawable/img_avatar_angler"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlayAppCornerFull" />

            <LinearLayout
                android:id="@+id/userCopy"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_10"
                android:layout_marginEnd="@dimen/spacing_8"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="@id/ivUserProfile"
                app:layout_constraintEnd_toStartOf="@id/btnMore"
                app:layout_constraintStart_toEndOf="@id/ivUserProfile"
                app:layout_constraintTop_toTopOf="@id/ivUserProfile">

                <TextView
                    android:id="@+id/tvUserName"
                    style="@style/TextAppearance.App.TitleSmall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="@string/user_name"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvPostTime"
                    style="@style/TextAppearance.App.BodySmall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="2 jam lalu"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnMore"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/more"
                android:padding="10dp"
                android:src="@drawable/ic_more_vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/text_secondary" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/tvCaption"
            style="@style/TextAppearance.App.BodyMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/spacing_12"
            android:paddingEnd="@dimen/spacing_12"
            android:paddingBottom="@dimen/spacing_10"
            android:ellipsize="end"
            android:maxLines="5"
            android:text="@string/post_caption_placeholder"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_12"
            android:layout_marginEnd="@dimen/spacing_12">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivPostImage"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="#F5F7FA"
                android:contentDescription="@string/post_image"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:src="@drawable/img_post_fish"
                app:layout_constraintDimensionRatio="16:10"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlayAppCornerMedium" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:id="@+id/layoutCatchInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_12"
            android:paddingTop="@dimen/spacing_10"
            android:paddingEnd="@dimen/spacing_12">

            <TextView
                android:id="@+id/tvFishType"
                style="@style/TextAppearance.App.BodySmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Jenis ikan: -"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvCatchMeta"
                style="@style/TextAppearance.App.BodySmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Lokasi tidak diketahui • Cuaca: - • Perairan: -"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/spacing_8"
            android:paddingEnd="@dimen/spacing_8">

            <ImageButton
                android:id="@+id/btnLike"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/like"
                android:padding="9dp"
                android:src="@drawable/ic_heart_outline"
                app:tint="@color/text_primary" />

            <TextView
                android:id="@+id/tvLikeCount"
                style="@style/TextAppearance.App.BodySmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_12"
                android:text="128"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <ImageButton
                android:id="@+id/btnComment"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/comment"
                android:padding="9dp"
                android:src="@drawable/ic_comment_rounded"
                app:tint="@color/text_primary" />

            <TextView
                android:id="@+id/tvCommentCount"
                style="@style/TextAppearance.App.BodySmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_12"
                android:text="32"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <ImageButton
                android:id="@+id/btnShare"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/share"
                android:padding="9dp"
                android:src="@drawable/ic_send_rounded"
                app:tint="@color/text_primary" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btnBookmark"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/save_favorite"
                android:padding="9dp"
                android:src="@drawable/ic_bookmark_outline"
                app:tint="@color/text_primary" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
