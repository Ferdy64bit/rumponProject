<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Primary Button Style -->
    <style name="WidgetAppButtonPrimary" parent="Widget.Material3.Button">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textColor">@color/onPrimary</item>
        <item name="backgroundTint">@color/primary</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">56dp</item>
    </style>

    <!-- Outlined Button Style -->
    <style name="WidgetAppButtonSecondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="strokeColor">@color/primary</item>
        <item name="android:minHeight">56dp</item>
    </style>

    <!-- Elevated Button Style (e.g. Google Button) -->
    <style name="WidgetAppButtonElevated" parent="Widget.Material3.Button.ElevatedButton">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="android:minHeight">56dp</item>
        <item name="backgroundTint">@color/surface</item>
        <item name="android:textColor">@color/onSurface</item>
        <item name="iconTint">@null</item>
    </style>
</resources>
