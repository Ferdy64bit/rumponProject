<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base Card Style -->
    <style name="WidgetAppCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="cardElevation">4dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="android:layout_marginBottom">@dimen/spacing_12</item>
    </style>

    <!-- Outlined Card Style -->
    <style name="WidgetAppCardOutlined" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="strokeColor">@color/outline</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
    </style>
</resources>
