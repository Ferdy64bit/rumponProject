<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Bridge for Design System Styles -->
    <!-- Most styles are now in granular files (buttons.xml, cards.xml, etc.) -->

    <!-- General Layout Styles -->
    <style name="LayoutScreenPadding">
        <item name="android:padding">@dimen/screen_margin</item>
    </style>

    <style name="CommonDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/divider</item>
    </style>

    <style name="DetailInfoTile">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">108dp</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:background">@drawable/bg_info_tile</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">@dimen/spacing_12</item>
    </style>

    <style name="DetailInfoIcon">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
    </style>

    <style name="DetailInfoLabel" parent="TextAppearance.App.BodySmall">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/spacing_8</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="DetailInfoValue" parent="TextAppearance.App.LabelLarge">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/spacing_2</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">13sp</item>
    </style>

</resources>
