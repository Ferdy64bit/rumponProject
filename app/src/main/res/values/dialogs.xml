<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Material Alert Dialog Style -->
    <style name="ThemeOverlayAppMaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="alertDialogStyle">@style/WidgetAppMaterialAlertDialog</item>
    </style>

    <style name="WidgetAppMaterialAlertDialog" parent="Base.Theme.Material3.Light.Dialog">
        <item name="backgroundTint">@color/surface</item>
        <item name="shapeAppearance">@style/ShapeAppearanceAppDialog</item>
    </style>

    <style name="ShapeAppearanceAppDialog" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_24</item>
    </style>
</resources>
